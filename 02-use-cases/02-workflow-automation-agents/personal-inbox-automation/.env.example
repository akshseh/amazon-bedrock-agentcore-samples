# Personal Inbox Automation Agent — Deploy-Time Configuration
# Copy to .env and fill in. .env is gitignored.

# ─── AWS Account ────────────────────────────────────────────────────
AWS_REGION=us-west-2
CDK_DEFAULT_ACCOUNT=123456789012

# ─── Agent Models ───────────────────────────────────────────────────
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6
FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ─── Gmail Integration (Option B: Polling) ─────────────────────────
# See docs/gmail-setup.md for step-by-step instructions.
GMAIL_SECRETS_ARN=
GMAIL_USER_EMAIL=you@gmail.com
GMAIL_LABEL_IDS=
MAX_MESSAGES_PER_POLL=10

# ─── Infrastructure ─────────────────────────────────────────────────
DESTROY_ON_DELETE=true
